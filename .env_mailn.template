# ==============================================================================
# CONFIGURACIÓN DEL BOT DE MAILING - DON YEYO S.A.
# TRIVIA: LA INOCUIDAD EN LOS PROCESOS PRODUCTIVOS (DESAFÍO DE INOCUIDAD 2026)
# Archivo de ejemplo: .env_mailn.template
# Copiar este archivo a .env_mailn y completar con las credenciales reales
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTIFICADOR DE CAMPAÑA / COLUMNA EN GOOGLE SHEETS
# ------------------------------------------------------------------------------
# Nombre EXACTO de la columna en la pestaña 'Participantes' donde se verificará
# y guardará la marca temporal (fecha y hora) de envío.
# Ejemplo: "Email Link de Trivia", "Recordatorio Fase 1", "Invitacion Lanzamiento"
# Si la columna no existe en la hoja de cálculo, el bot se detendrá con error sin enviar correos.
NEWSLETER_ACTUAL="Email Link de Trivia"

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL SERVIDOR SMTP (ENVÍO DE CORREOS)
# ------------------------------------------------------------------------------
# Para Gmail: usar host smtp.gmail.com, puerto 587 o 465 y una "Contraseña de aplicación" de Google.
# Para Microsoft 365 / Outlook: usar smtp.office365.com, puerto 587.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-correo@empresa.com"
SMTP_PASS="tu-contraseña-o-app-password"
SMTP_FROM="\"Desafío de Inocuidad - Don Yeyo\" <tu-correo@empresa.com>"

# ------------------------------------------------------------------------------
# 3. TEXTOS Y CONTENIDOS DINÁMICOS DE LA PLANTILLA MAILING (%COMODINES%)
# ------------------------------------------------------------------------------
TITULO_EMAIL="¡Acceso Oficial a la Trivia de Inocuidad 2026!"
SUBTITULO="Don Yeyo S.A. • Desafío de Calidad e Inocuidad"
MENSAJE_PRINCIPAL="<p>Te damos la bienvenida al <strong>Desafío de Inocuidad 2026</strong>. Ya se encuentra habilitada la plataforma para que pongas a prueba tus conocimientos sobre las buenas prácticas y procesos de nuestra planta.</p><p>Hacé clic en el siguiente botón para ingresar con tu acceso personal intransferible:</p>"
MENSAJE_SECUNDARIO="💡 <strong>Recordatorio importante:</strong> Tendrás un tiempo límite por pregunta y tus respuestas sumarán puntos para el ranking de clasificación de tu sector. ¡Mucho éxito!"
CALL_TO_ACTION_TEXTO="INGRESAR A LA TRIVIA AHORA"
CALL_TO_ACTION_URL="https://dy-inocuidad.netlify.app"
EMPRESA_NOMBRE="Don Yeyo S.A. • Departamento de Calidad e Inocuidad"
CONTACTO_SOPORTE="Para consultas o inconvenientes de acceso, comunicate con el área de Calidad."
ANIO_ACTUAL="2026"

# URL base de la aplicación de la Trivia (usada para armar {{link_trivia}} = APP_BASE_URL/?token=TOKEN_HASH)
APP_BASE_URL="https://dy-inocuidad.netlify.app"

# ------------------------------------------------------------------------------
# 4. PARÁMETROS DE ENVÍO Y MODO DE PRUEBA
# ------------------------------------------------------------------------------
# Correo de destino para pruebas previas al envío masivo (ej: npm run mailing:test)
TEST_EMAIL="tu-email-de-prueba@empresa.com"

# Pausa entre cada envío en milisegundos (evita bloqueos por spam o límites de cuota de los servidores SMTP)
SMTP_DELAY_MS=1200

# Ruta de la plantilla HTML a utilizar (por defecto busca ./mailing.html o ./mailing/mailing.html)
MAILING_TEMPLATE_PATH="./mailing.html"

# Carpeta que contiene las imágenes del mailing (adjuntos CID inline)
MAILING_ASSETS_DIR="./mailing"

