# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO - DON YEYO S.A.
# TRIVIA: LA INOCUIDAD EN LOS PROCESOS PRODUCTIVOS (SEMANA DE LA INOCUIDAD 2026)
# ==============================================================================

# Nombre corporativo de la aplicación
VITE_APP_TITLE="Trivia Inocuidad 2026 - Don Yeyo"

# Frase clave semilla para cálculo de Hash criptográfico SHA256 de enlaces únicos
# Generación: SHA256(VITE_SEED_PHRASE + legajo + apellido + nombre)
VITE_SEED_PHRASE="DY_INOCUIDAD_2026_CALIDAD_Y_COMPROMISO"

# Fase habilitada actualmente (Valores posibles: 1, 2 o 3)
# Al cambiar de fase, los enlaces únicos de los usuarios vuelven a habilitarse para la nueva fase
VITE_ACTIVE_PHASE=1

# Modo de presentación de preguntas (true: al azar / aleatorio, false: secuencial según orden de planilla)
VITE_SHUFFLE_QUESTIONS=false

# Tiempo límite por pregunta en segundos (0 = sin límite individual por pregunta)
VITE_TIME_PER_QUESTION=45

# Tiempo límite total máximo de permanencia en segundos (ej: 600 = 10 minutos, 0 = sin límite)
VITE_MAX_TIME_TOTAL=600

# Origen de datos (Valores: 'csv' para modo local / offline, 'google_sheets' para Google Sheets API / CSV publish)
VITE_DATA_SOURCE="csv"

# URL de Google Sheets publicada como CSV o Web API para Preguntas (Fases 1, 2 y 3)
# Ejemplo: https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv
VITE_GOOGLE_SHEET_QUESTIONS_URL=""

# URL de Google Sheets publicada como CSV o Web API para Usuarios y Registro de Fases
# Ejemplo: https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=12345&single=true&output=csv
VITE_GOOGLE_SHEET_USERS_URL=""

# Endpoint de Google Apps Script / Webhook para registrar fecha/hora de acceso y respuestas en tiempo real
VITE_GOOGLE_APPS_SCRIPT_ENDPOINT=""
