SMTP_PASS="tu_contraseña_o_app_password"
SMTP_FROM_NAME="Semana de la Inocuidad 2026 - Don Yeyo"
SMTP_FROM_EMAIL="usuario@donyeyo.com.ar"
SMTP_DELAY_MS=400
