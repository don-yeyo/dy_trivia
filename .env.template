TEST_EMAIL="tu-email-de-prueba@donyeyo.com.ar"

# ==============================================================================
# 🎛️ VARIABLES FRONTEND / FALLBACK MODO DESARROLLO (VITE_)
# ==============================================================================
VITE_APP_TITLE="Trivia Inocuidad 2026 - Don Yeyo"
VITE_ADMIN_BRAND_NAME="DY-TRIVIA"

# Cantidad de participantes a mostrar por página en el panel de administración (por defecto: 100)
VITE_ADMIN_PARTICIPANTS_PER_PAGE=100
VITE_DATA_SOURCE="supabase"
# ==============================================================================
# 🎮 CÁLCULO DE PUNTAJE GAMER (OPCIÓN 1: JERARQUÍA POR ACIERTOS + VELOCIDAD)
# ==============================================================================
# Fórmula: (Aciertos * POINTS_PER_CORRECT) + round((Aciertos / Segundos) * SCORE_TIME_FACTOR)
# Garantiza que quien acierte más preguntas siempre clasifique por encima de quien acertó menos.
# Ejemplo: 14 aciertos en 117s = (14 * 10000) + round((14/117)*1000) = 140.120 puntos
POINTS_PER_CORRECT=10000
VITE_POINTS_PER_CORRECT=10000
SCORE_TIME_FACTOR=1000
VITE_SCORE_TIME_FACTOR=1000

VITE_ALLOW_SESSION_RESET=false
VITE_MAX_TIME_TOTAL=600

# ℹ️ NOTA DE ARQUITECTURA Y SEGURIDAD:
# Las configuraciones operativas de la trivia ahora residen dinámicamente en Supabase (tabla `config`):
#  - FASE_ACTIVA (1, 2 o 3)
#  - FASE_CERRADA (true / false)
#  - CLASIFICACION_PUBLICADA (true / false)
#  - CLASIFICACION_TOP_COUNT (ej: 30)
#  - MOSTRAR_PARCIALES_EN_TABLA (true / false)
#  - MOSTRAR_NO_RESPONDIDOS_EN_TABLA (true / false)
#  - TIEMPO_POR_PREGUNTA (segundos por pregunta, ej: 45)
#  - MEZCLAR_PREGUNTAS (true / false)
#  - OCULTAR_RESUMEN_RESPONDIDAS (true / false)
#  - OCULTAR_RESUMEN_TIEMPO (true / false)
#  - EMAILS_ENVIADOS (Mapa JSON con { [legajo]: true/false })
#
# La única fuente de verdad para el frontend es lo que el backend serverless le instruye,
# impidiendo cualquier intento de adulteración desde la consola del navegador, local storage o cookies.
#
