# ==============================================================================
# 🔒 VARIABLES DE BACKEND SEGURO (NETLIFY SERVERLESS FUNCTIONS)
# ==============================================================================
# Estas variables se configuran en Netlify > Site configuration > Environment variables
# y son custodiadas exclusivamente por el backend (Netlify Functions). NUNCA se exponen al cliente.
GOOGLE_SHEETS_SPREADSHEET_ID="1txRiWnszPxjH0iixtr_zwHDFYAiArOyIaVlylXECJCw"
GOOGLE_SHEETS_API_KEY=""

# Rangos de lectura en Google Sheets API v4
GOOGLE_SHEETS_CONFIG_RANGE="Configuracion!A1:C30"
GOOGLE_SHEETS_QUESTIONS_RANGE="Preguntas!A1:Z100"
GOOGLE_SHEETS_USERS_RANGE="Participantes!A1:Z500"
GOOGLE_SHEETS_RESULTS_RANGE="Resultados!A1:Z1000"

# Endpoint de Google Apps Script (Webhook de inserción/actualización de respuestas y configs)
GOOGLE_APPS_SCRIPT_ENDPOINT=""

# Frase clave semilla para cálculo de Hash criptográfico SHA256 de enlaces únicos
# Generación: SHA256(SEED_PHRASE + legajo + apellido + nombre)
SEED_PHRASE="DY_INOCUIDAD_2026_CALIDAD_Y_COMPROMISO"

# Credenciales de Administrador para determinar y publicar clasificados (Exclusivo Backend Netlify)
# NUNCA usar prefijo VITE_ para no exponerlas al cliente en el frontend
ADMIN_USER="inocuadmin"
ADMIN_PASSWORD="superpassword123"

# ==============================================================================
# 🎛️ VARIABLES FRONTEND / FALLBACK MODO DESARROLLO (VITE_)
# ==============================================================================
VITE_APP_TITLE="Trivia Inocuidad 2026 - Don Yeyo"
VITE_DATA_SOURCE="google_sheets_api"
VITE_ALLOW_SESSION_RESET=false
VITE_MAX_TIME_TOTAL=600

# Rango de configuración para fallback en desarrollo local si no hay funciones Netlify
VITE_GOOGLE_SHEETS_CONFIG_RANGE="Configuracion!A1:C30"

# ℹ️ NOTA DE ARQUITECTURA Y SEGURIDAD:
# Las siguientes variables anteriormente por entorno ahora se gestionan y gobiernan dinámicamente 
# desde la pestaña "Configuracion" en Google Sheets con una columna de "Descripcion":
#  - FASE_ACTIVA (1, 2 o 3)
#  - FASE_CERRADA (true / false)
#  - CLASIFICACION_PUBLICADA (true / false)
#  - CLASIFICACION_TOP_COUNT (ej: 30)
#  - MOSTRAR_PARCIALES_EN_TABLA (true / false)
#  - MOSTRAR_NO_RESPONDIDOS_EN_TABLA (true / false)
#  - TIEMPO_POR_PREGUNTA (segundos por pregunta, ej: 45)
#  - MEZCLAR_PREGUNTAS (true / false)
#  - OCULTAR_RESUMEN_RESPONDIDAS (true / false)
#  - OCULTAR_RESUMEN_TIEMPO (true / false)
#
# La única fuente de verdad para el frontend es lo que el backend serverless le instruye,
# impidiendo cualquier intento de adulteración desde la consola del navegador, local storage o cookies.
